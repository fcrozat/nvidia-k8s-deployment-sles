#!/bin/bash
# config.sh - Private configuration for deploy.sh and upgrade.sh
# Copy this file to config.sh and fill in your values.
# config.sh is gitignored and should NOT be committed.
# shellcheck disable=SC2034
# All variables in this file are consumed by deploy.sh and upgrade.sh.

# Per-target host configurations
# Each target defined by TARGET_OS needs: HOST_<target>, USER_<target>, K8S_DISTRO_<target>
# Dots in target names are replaced with underscores (e.g. 15.7 -> 15_7)
# NEEDS_MIRROR_<target>: set to "true" if the target cannot reach INTERNAL_REGISTRY directly
HOST_15_7=""              # e.g. "my-host.eu-central-1.ip.aws"
USER_15_7="ec2-user"
K8S_DISTRO_15_7="k3s"
NEEDS_MIRROR_15_7="true"

HOST_16_0=""              # e.g. "my-other-host.eu-central-1.ip.aws"
USER_16_0="ec2-user"
K8S_DISTRO_16_0="k3s"
NEEDS_MIRROR_16_0="true"

HOST_16_1=""              # e.g. "my-gpu-host.eu-central-1.ip.aws"
USER_16_1="ec2-user"
K8S_DISTRO_16_1="k3s"
NEEDS_MIRROR_16_1="true"

# Example additional targets:
# HOST_onprem=""          # e.g. "gpu-server.internal.example.com"
# USER_onprem="admin"
# K8S_DISTRO_onprem="rke2"
# NEEDS_MIRROR_onprem="false"
#
# Baremetal system vera72 (e.g. SLES for Nvidia 16.1):
# HOST_vera72=""       # e.g. "10.78.214.72"
# USER_vera72="root"
# K8S_DISTRO_vera72="k3s"
# NEEDS_MIRROR_vera72="false"

# Default target when TARGET_OS is not set
DEFAULT_TARGET="15_7"

# Internal registry (used for registries.yaml configuration and mirroring checks)
INTERNAL_REGISTRY=""      # e.g. "registry.example.com"

# Internal registry for prebuilt driver containers (non-production)
# Used when USE_PREBUILT_CONTAINER=true (but not "production")
INTERNAL_DRIVER_REGISTRY_15SP6=""  # e.g. "registry.example.com/nvidia/containerfile_15sp6/nvidia"
INTERNAL_DRIVER_REGISTRY_15SP7=""  # e.g. "registry.example.com/nvidia/containerfile_15sp7/nvidia"
INTERNAL_DRIVER_REGISTRY_16=""     # e.g. "registry.example.com/nvidia/containerfile_16/nvidia"

# Driver container build repository
# DRIVER_CONTAINER_REPO="https://github.com/SUSE/BCI-dockerfile-generator.git"

# Default prebuilt driver repository for upgrade.sh
DEFAULT_UPGRADE_DRIVER_REPOSITORY=""  # e.g. "registry.example.com/product/nvidia"

# Private Helm repository for GPU Operator
# If USE_HELM_PRIVATE_REGISTRY=true, the GPU Operator chart will be fetched from HELM_PRIVATE_URL
# If HELM_PRIVATE_URL does not end in .tgz, the filename is assumed to be gpu-operator-${GPU_OPERATOR_VERSION}.tgz
# USE_HELM_PRIVATE_REGISTRY can also be set per target (e.g. USE_HELM_PRIVATE_REGISTRY_16_0="true")
USE_HELM_PRIVATE_REGISTRY="false"
HELM_PRIVATE_URL="" # Global:  "https://helm.ngc.nvidia.com/nvidia"
NGC_API_KEY=""      # Global: API Key for NGC authentication

# Network Operator configuration
# Set DEPLOY_NETWORK_OPERATOR=true to install NVIDIA Network Operator alongside GPU Operator
# Can also be set per target (e.g. DEPLOY_NETWORK_OPERATOR_vera72="true")
DEPLOY_NETWORK_OPERATOR="false"
NETWORK_OPERATOR_VERSION="v26.7.0"
# NETWORK_OPERATOR_NAMESPACE="nvidia-network-operator"
# NIC_CLUSTER_POLICY_FILE="" # Path to NicClusterPolicy YAML to apply (see nic-cluster-policy.yaml.example)

# DOCA Driver Container configuration (for NVIDIA Network Operator)
# Set BUILD_DOCA_DRIVER=true (or pass --build-doca-driver to deploy.sh) to build and push
# the precompiled DOCA-OFED driver container using doca-driver-build.
# Can also be set per target (e.g. BUILD_DOCA_DRIVER_vera72="true")
BUILD_DOCA_DRIVER="false"
DOCA_VERSION="3.5.0"
DOCA_OFED_VERSION="26.07-0.7.7.0"
DOCA_CONTAINER_VER="0"
DOCA_DRIVER_REPO="https://github.com/fcrozat/doca-driver-build.git"
DOCA_DRIVER_BRANCH="SLES16"
# DOCA_DRIVER_IMAGE="doca-driver"
